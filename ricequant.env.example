# Copy to ricequant.env, replace the value, and chmod 600 ricequant.env.
# Use the complete opaque RiceQuant/RQSDK license supplied by RiceQuant.
RQDATA_TOKEN=replace-with-the-issued-license

# Optional ClickHouse environment overrides. Values here take precedence over
# ricequant.yaml. Uncomment only when needed.
# DB_PASSWORD=replace-with-clickhouse-password
# DB_HOST=127.0.0.1
# DB_PORT=8123
# DB_USER=default
# DB_NAME=default
